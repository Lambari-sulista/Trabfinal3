class TerminalUI {
public:
    // Limpeza de tela e reposicionamento do cursor
    static void limparTela() {
        std::cout << "\033[2J\033[1;1H" << std::flush;
    }

    // Estilos de Texto
    static constexpr const char* RESET     = "\033[0m";
    static constexpr const char* NEGRITO   = "\033[1m";
    static constexpr const char* SUBLINHADO= "\033[4m";

    // Cores de Texto (Foreground)
    static constexpr const char* VERMELHO  = "\033[31m";
    static constexpr const char* VERDE     = "\033[32m";
    static constexpr const char* AMARELO   = "\033[33m";
    static constexpr const char* AZUL      = "\033[34m";
    static constexpr const char* MAGENTA   = "\033[35m";
    static constexpr const char* CIANO     = "\033[36m";
    static constexpr const char* BRANCO    = "\033[37m";

    // Cores de Fundo (Background)
    static constexpr const char* BG_PRETO  = "\033[40m";
    static constexpr const char* BG_BRANCO = "\033[47m";

    // Função utilitária para desenhar a barra de energia do jogo
    static void renderizarBarraEnergia(int energiaAtual, int energiaMax = 100) {
        std::cout << NEGRITO << "Energia: [";
        
        // Define a cor baseada no nível de energia
        if (energiaAtual > 50) std::cout << VERDE;
        else if (energiaAtual > 20) std::cout << AMARELO;
        else std::cout << VERMELHO;

        int blocosTotais = 20; // Tamanho visual da barra
        int blocosPreenchidos = (energiaAtual * blocosTotais) / energiaMax;

        for (int i = 0; i < blocosTotais; ++i) {
            if (i < blocosPreenchidos) std::cout << "█";
            else std::cout << " ";
        }
        
        std::cout << RESET << NEGRITO << "] " << energiaAtual << "%" << RESET << "\n";
    }
};